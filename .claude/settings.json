{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"model": "sonnet",
	"permissions": {
		"defaultMode": "default",
		"allow": [
			"Bash(npm run build)",
			"Bash(npm run lint)",
			"Bash(npm run lint:fix)",
			"Bash(npm run format)",
			"Bash(npm run test)",
			"Bash(npm run test *)",
			"Bash(npm test)",
			"Bash(npm test *)",
			"Bash(npm audit)",
			"Bash(npx rbxtsc *)",
			"Bash(npx eslint *)",
			"Bash(npx prettier *)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git branch *)",
			"Bash(git show *)"
		],
		"ask": [
			"Bash(npm install *)",
			"Bash(npm uninstall *)",
			"Bash(npm update *)",
			"Bash(npm audit fix *)",
			"Bash(npx *)",
			"Bash(rojo *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git merge *)",
			"Bash(git rebase *)",
			"Bash(git checkout *)",
			"Bash(gh *)",
			"Edit(./.github/**)",
			"Write(./.github/**)",
			"Edit(./.claude/**)",
			"Write(./.claude/**)",
			"Edit(./package.json)",
			"Edit(./CLAUDE.md)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/.ssh/**)",
			"Read(**/.aws/**)",
			"Read(./node_modules/**)",
			"Read(./out/**)",
			"Read(./include/**)",
			"Read(./package-lock.json)",
			"Edit(./.env)",
			"Edit(./.env.*)",
			"Write(./.env)",
			"Write(./.env.*)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(rm -rf *)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)",
			"Bash(git clean *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/format.mjs"
					}
				]
			}
		]
	}
}
